{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "biliClipFlow",
  "version": "1.0.0",
  "identifier": "com.tbw.biliclipflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5176",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "biliClipFlow",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$VIDEO/**",
            "$DOWNLOAD/**",
            "$PICTURE/**",
            "$TEMP/**",
            "$APPCACHE/**",
            "$APPDATA/**",
            "$APPLOCALDATA/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/macos/*",
      "bin/windows/*",
      "bin/linux/*",
      "bin/README.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
